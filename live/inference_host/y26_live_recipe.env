# y26_live_recipe.env — 配信専用推論 host のビルド定義(旧 host_recipe.env。2026-09-10 に改名)。
#   build_live.sh host が source して BASE_DEF と HOST_ELF を使う。ここが -D 群の唯一の正。
#
#   ★開発機のパス・git rev・旧 ELF の再現手順といった **本 repo の外を指す記録**は、
#     公開物から外して別途保管している(公開 repo だけで完結させるため)。
HOST_ELF="yolov7_host_overlap_camlive_geo640x640_ovl"
MODE="overlap"
N="2"
GMEM_MB="256"
CAMERA_LIVE="1"
EXTRA_DEF=""
GEO640_NETH="640"
GEO640_NETW="640"
GEO640_ANCHOR_DEF="-DHB_TOP_WORDS=524288u -DBATCH_OUT_BASE=432128"   # 基準 384x640 と差がある anchor
BASE_DEF="-DPHASE3_STREAM -DPHASE3_OVERLAP -DPHASE2_GOAXIS -DUSE_STREAM_BATCH -DBATCH_PINGPONG -DSTREAM_NIMG_RUNTIME -DBATCH_COSIM_CHAIN -DUSE_DONE_AXIS -DSTREAM_NIMG=2 -DGMEM_DATA64_SIZE_MB=256 -DY26_NETH=640u -DY26_NETW=640u -DHB_TOP_WORDS=524288u -DBATCH_OUT_BASE=432128 -DCAMERA_LIVE -DBATCH_IN_BASE=278528"   # ★展開後の全 -D。これが同一なら同一 host
# ソース同一性の判定はこの 2 つの md5 + 上の BASE_DEF で行う(ELF の md5 は __DATE__ で毎回変わるので使わない)。
SRC_Y26LIVE_CPP_MD5="3139904a50010839e94c577dced40879"   # src/y26_live.cpp(2026-09-24 更新: PE 重みの int16 飽和化 + 未ロード警告)
SRC_Y26LIVE_H_MD5="7b60045a3da069be75b5333f810beb20"     # include/y26_live.h(2026-09-12 更新×2。25c の 29b5ad6 でコメント 1 行が変わった。★ELF は 3f586c9d のまま不変 = 再ビルドで実測確認済)

# ★2026-09-10 配信専用化(tasks.cpp 廃止 / ヘッダ 1 本化)後の注記
#   - ビルドは build_live.sh host のみ。対象 = src/y26_live.cpp + include/y26_live.h の 2 ファイル。
#   - 上の BASE_DEF のうち **host の生成コードに効くのは 7 個だけ**(実測: 残りを外しても .text md5 一致):
#       -DY26_NETH=640u -DY26_NETW=640u -DGMEM_DATA64_SIZE_MB=256 -DHB_TOP_WORDS=524288u
#       -DBATCH_IN_BASE=278528 -DBATCH_OUT_BASE=432128 -DSTREAM_NIMG=2
#     残り(PHASE3_STREAM 等)は kernel 側と共有する識別子。ELF 同一性の記録として BASE_DEF はそのまま残す。
#   - Vitis の include(ap_int.h)への依存は解消した(GMEM_T を 64B POD 化)。VITIS_INC は不要。
#   - 配布アーカイブ同梱の配備 ELF(c6b433a0)は簡素化前のビルドで、本ソースとはバイナリが異なる。
#     推論結果が同一であることは board の canary(6 head digest が GOLD と一致)で確認済み。

# ── 決定論ビルド(2026-09-10 追加)────────────────────────────────────────────
#   y26_live.cpp は __DATE__/__TIME__ を起動ログの build_id に埋める(:332, :774)。固定しないと
#   1 秒違うだけで ELF の md5 が変わり、「配備品と同じものをビルドできたか」を md5 で示せない。
#   build_live.sh が下の値を SOURCE_DATE_EPOCH として使い -D__DATE__/-D__TIME__ を注入する。
#   ★動かすと ELF md5 が変わる。動かすときは MD5SUMS.expect.txt も一緒に更新すること。
SOURCE_DATE_EPOCH_DEFAULT="1788998400"   # 2026-09-10 00:00:00 UTC = "Sep 10 2026" "00:00:00"
EXPECT_HOST_ELF_MD5="5446141e498174271d65d246eac2107e"   # 上の epoch でビルドした $HOST_ELF(v1.1。v1.0 は 3f586c9d)
