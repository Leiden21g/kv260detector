# geo640.env — 入力幾何の確定値(shell 形式)。★値の唯一の受け渡し経路。
#   各ビルド・launcher は直書きせず必ずここを source する。
#   使い方: [ -f scripts/geo640.env ] && . scripts/geo640.env
#           -D 群 = $GEO640_DEFS(kernel csynth / host build / nn build に同じ値を渡す)
# ★H1-②〜⑥(2026-08-28)確定値 = **640×640**。旧 384×640 は scripts/geo384.env(配備 n.q の再現は gen_deployed_nq.sh がそちらを使う)。
#   640 n.q の再現 = scripts/gen_geo640_nq.sh(期待 md5 60c0665d)。peak 実測 271616 word < BATCH_IN_BASE 278528(余裕 6912)。
Y26_NETH=640            # 入力 H(8 の倍数)
Y26_NETW=640            # 入力 W
Y26_IN_STRIDE=51200     # = NETH*NETW*4ch*2B/64B [word](tasks.h で導出。ここは参照用の写し)
Y26_HEAD_STRIDE=25344   # 6 head 1 set [word](tasks.h で導出。参照用)
Y26_FRONT_RESERVE=153088 # = 2*IN_STRIDE + 2*HEAD_STRIDE(参照用)
HB_TOP_WORDS=524288     # 32MB anchor(640 化で peak が 16MB anchor 超え)
GMEM_DATA64_SIZE_MB=512 # production(native 既定 128 とは別メモリマップ)
BATCH_IN_BASE=278528    # ★確定(H1-④ peak=271616 + 余裕、64word 整列)。IN 3 slot [278528,432128)
BATCH_OUT_BASE=432128   # ★確定 = IN_BASE + 3*IN_STRIDE(51200)。OUT 3 slot ×8192 → 456704 < PE_GMEM_OFFSET(≈524151)
GMEM_MB=256             # host BO サイズ(MB)
# ★kernel/host/nn へ同一値で渡す -D 群(幾何 + anchor)。HB_TOP_WORDS/OUT_BASE は各ビルド既定に任せる(step1 は不変)
MGR_CYC_BASE=456704     # probe(PROBE_PERSTAGE)の cyclestamp DDR 域(512 word)。OUT 域末尾 456704 の直上、< PE_GMEM_OFFSET 524151
GEO640_PP_HWC16=1       # ★2026-08-29: ppdaemon/camera_preprocess を int16 量子化済 HWC16 publish(3.3MB)にし host refill を軽くする。launcher は PP_HWC16 未指定時にこれを採る
# ★2026-08-29 の A/B(G5 PASS)で確定した live 運用キー。launcher は幾何≠384x640 で cvac/SNAP_THREADS=2/PP_HWC16=1 を既定にし、GEO640_* キー or 起動 env で個別 off 可。実効 gate は 2 つ(cvac + SNAP_THREADS)
GEO640_FPS_CAP=8        # live FPS 蓋。★2026-08-29 実測 8.70fps(蓋 7/8 と同等 = 推論律速)で 7→8
GEO640_CAP_FPS=9        # capd 取込 fps(#18 で 8→9)
GEO640_GO_FLUSH=cvac    # host go: 16MB evict → 書いた 64B×2 の dc cvac(go 11.6→0ms)。GOLD 一致確認済
GEO640_SNAP_THREADS=2   # DEFER 背景 snapshot の並列(snap 10→6.4ms)。GOLD 一致確認済
GEO640_HEAD_SKIP_P4CLS=0 # ★既定 OFF(2026-08-29 訂正): 有効条件は「DUMP_HEADS_NOFILE ∧ VCU_KEEP_P4 無し」だが live overlay は VCU_KEEP_P4=1 = 常に no-op。P4 を捨てる運用専用の予備
ATTN_TOK_CAP=400        # kernel attention token 容量(tasks_kernel.cpp 既定は幾何連動: P5=(640/32)^2=400)
GEO640_DEFS="-DY26_NETH=${Y26_NETH}u -DY26_NETW=${Y26_NETW}u -DGMEM_DATA64_SIZE_MB=${GMEM_DATA64_SIZE_MB} -DHEAD_RESERVE_FRONT -DHB_TOP_WORDS=${HB_TOP_WORDS}u -DBATCH_IN_BASE=${BATCH_IN_BASE} -DBATCH_OUT_BASE=${BATCH_OUT_BASE} -DMGR_CYC_BASE=${MGR_CYC_BASE}"

# ★2026-09-04 依頼#34続き: head pin n.q 3a83aeb5 + host ELF 採用に伴う GO_EARLY 恒久配線
#   (配備版から取り込み。2026-09-10 に原本と配備版を union で一致させた)
GEO640_GO_EARLY=1
GEO640_CAPD_PUB=1
